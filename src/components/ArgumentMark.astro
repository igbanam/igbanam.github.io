---
/* Deterministic generative argument diagram — Spec §4.4 */
import { seedInts } from "../utils/slug";
interface Props { seed: string; width?: number; height?: number; }
const { seed, width = 320, height = 420 } = Astro.props;
const ints = seedInts(seed, 6);
const patterns = ["brackets", "tree", "trace", "map"] as const;
const pattern = patterns[ints[0] % patterns.length];
const accent = ints[1] % 7; // which element gets proof color
---

<svg
  width={width} height={height}
  viewBox="0 0 320 420"
  role="img" aria-hidden="true"
  class="argument-mark"
>
  <rect width="320" height="420" rx="2" fill="none" stroke="var(--rule)" stroke-width="1" />
  <!-- Top label -->
  <text x="16" y="28" font-family="ui-monospace,monospace" font-size="8" letter-spacing="0.08em" fill="var(--ink-muted)">ARGUMENT DIAGRAM — {seed.slice(0, 18)}</text>
  <line x1="16" y1="36" x2="304" y2="36" stroke="var(--rule)" stroke-width="0.7" />

  {pattern === "brackets" && (
    <>
      {Array.from({ length: 5 }).map((_, i) => {
        const y = 60 + i * 62;
        const w = 40 + (ints[(i+1)%6] % 90);
        const isAccent = i === accent % 5;
        return (
          <g>
            <line x1="28" y1={y} x2="28" y2={y+36} stroke={isAccent ? "var(--proof)" : "var(--rule)"} stroke-width={isAccent ? 1.5 : 0.9} />
            <line x1="28" y1={y} x2={28+w} y2={y} stroke="var(--rule)" stroke-width="0.6" />
            <line x1="28" y1={y+36} x2={28+w} y2={y+36} stroke="var(--rule)" stroke-width="0.6" />
            <text x="34" y={y+16} font-family="ui-monospace,monospace" font-size="7" fill="var(--ink-muted)">{`NODE_${String(i+1).padStart(2,"0")}`}</text>
          </g>
        );
      })}
      <!-- connection spine -->
      <line x1="28" y1="72" x2="28" y2="340" stroke="var(--rule)" stroke-width="0.5" stroke-dasharray="3 4" />
    </>
  )}

  {pattern === "tree" && (
    <>
      <circle cx="160" cy="70" r="6" fill="none" stroke="var(--ink-muted)" stroke-width="1" />
      <text x="160" y="74" text-anchor="middle" font-family="ui-monospace,monospace" font-size="5" fill="var(--ink-muted)">◉</text>
      {[0,1,2].map(i => {
        const lx = 60 + i*70 + (ints[i+2]%10)-5;
        const ly = 140 + (ints[i+1]%30);
        const isAccent = i === accent % 3;
        return (
          <g>
            <line x1="160" y1="76" x2={lx} y2={ly-16} stroke={isAccent ? "var(--proof)" : "var(--rule)"} stroke-width={isAccent?1.2:0.7} />
            <rect x={lx-34} y={ly-14} width="68" height="22" rx="1" fill="none" stroke={isAccent?"var(--proof)":"var(--rule)"} stroke-width={isAccent?1:0.7} />
            <text x={lx} y={ly} text-anchor="middle" font-family="ui-monospace,monospace" font-size="6" fill="var(--ink-muted)">{`BR_${i+1}`}</text>
          </g>
        );
      })}
      {[0,1,2,3].map(i => {
        const x = 40 + i*66 + (ints[i]%12)-6;
        const y = 240 + (ints[(i+2)%6]%40);
        return (
          <g>
            <line x1={60 + (i%3)*70} y1="150" x2={x} y2={y-10} stroke="var(--rule)" stroke-width="0.5" stroke-dasharray="2 3" />
            <rect x={x-26} y={y-10} width="52" height="18" rx="1" fill="none" stroke="var(--rule)" stroke-width="0.6" />
            <text x={x} y={y+1} text-anchor="middle" font-family="ui-monospace,monospace" font-size="5.5" fill="var(--ink-muted)">{`LF_${i+1}`}</text>
          </g>
        );
      })}
    </>
  )}

  {pattern === "trace" && (
    <>
      {/* packet trace lines */}
      {Array.from({ length: 6 }).map((_, i) => {
        const y = 62 + i*48;
        const isAccent = i === accent % 6;
        return (
          <g>
            <text x="28" y={y} font-family="ui-monospace,monospace" font-size="6.5" fill="var(--ink-muted)">{`→ ${String(i*17+ints[i%6]%10).padStart(4,"0")}  ·  ${["SYN","ACK","PSH","FIN","RST","ACK"][i]}`}</text>
            <line x1="120" y1={y-4} x2="290" y2={y-4} stroke={isAccent?"var(--proof)":"var(--rule)"} stroke-width={isAccent?1:0.6} />
            <circle cx="290" cy={y-4} r="2.5" fill={isAccent?"var(--proof)":"none"} stroke={isAccent?"var(--proof)":"var(--rule)"} stroke-width="0.7" />
          </g>
        );
      })}
      <text x="28" y="390" font-family="ui-monospace,monospace" font-size="6" fill="var(--ink-muted)">seq {ints[2] % 9999} · win {ints[3] % 512}</text>
    </>
  )}

  {pattern === "map" && (
    <>
      <!-- boundary map -->
      <rect x="28" y="56" width="264" height="300" rx="1" fill="none" stroke="var(--rule)" stroke-width="0.7" stroke-dasharray="4 3" />
      {Array.from({ length: 4 }).map((_, i) => {
        const x = 50 + (ints[i]%160) + i*22;
        const y = 90 + (ints[(i+2)%6]%180);
        const isAccent = i === accent % 4;
        return (
          <g>
            <circle cx={x} cy={y} r={isAccent?7:4} fill={isAccent?"var(--proof)":"none"} stroke={isAccent?"var(--proof)":"var(--ink-muted)"} stroke-width="0.9" />
            <text x={x} y={y+18} text-anchor="middle" font-family="ui-monospace,monospace" font-size="6" fill="var(--ink-muted)">{`Z${i+1}`}</text>
            {i>0 && <line x1={50 + (ints[i-1]%160)+(i-1)*22} y1={90+(ints[(i+1)%6]%180)} x2={x} y2={y} stroke="var(--rule)" stroke-width="0.5" stroke-dasharray="2 3" />}
          </g>
        );
      })}
    </>
  )}

  <!-- bottom proof mark -->
  <line x1="16" y1="400" x2="80" y2="400" stroke="var(--proof)" stroke-width="2.5" />
  <text x="88" y="403" font-family="ui-monospace,monospace" font-size="7" letter-spacing="0.06em" fill="var(--ink-muted)">PROOF — VERIFIED</text>
</svg>

<style>
  .argument-mark {
    width: 100%;
    height: auto;
    max-width: 360px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
  }
</style>
