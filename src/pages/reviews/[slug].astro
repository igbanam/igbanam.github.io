---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { reviewSlug } from "../../utils/slug";
export async function getStaticPaths() {
  const reviews = await getCollection("reviews");
  return reviews.map(r => ({ params: { slug: reviewSlug(r.id) }, props: { review: r } }));
}
const { review } = Astro.props;
const { Content } = await render(review);
const siteUrl = Astro.site?.toString() ?? "https://igbanam.com/";
const canon = new URL(`/reviews/${reviewSlug(review.id)}/`, siteUrl).toString();
---

<Base title={review.data.title} description={review.data.excerpt || review.data.verdict || ""} canonical={canon} current="/reviews/">
  <article class="canvas" style="padding: var(--s-8) 0 var(--s-12); max-width:66ch;">
    <h1 class="font-display" style="font-size: clamp(1.6rem, 4vw, 2.2rem); line-height:1.1;">{review.data.title}</h1>
    {review.data.author && <p class="font-mono" style="font-size:0.75rem; color:var(--ink-muted); margin-top:6px;">{review.data.author}</p>}
    {review.data.verdict && <blockquote style="border-left:3px solid var(--proof); padding:10px 16px; background:var(--paper-raised); margin-top:12px; font-style:italic;">“{review.data.verdict}”</blockquote>}
    {review.data.rating !== undefined ? <p class="font-mono" style="font-size:0.8rem; color:var(--ink-muted); margin-top:8px;" role="meter" aria-valuenow={review.data.rating} aria-valuemin={0} aria-valuemax={5}>{review.data.rating} / 5</p> : <p class="font-mono" style="font-size:0.8rem; color:var(--ink-muted); margin-top:8px;">Unrated</p>}
    <div class="prose" style="margin-top:20px; line-height:1.75;">
      <Content />
    </div>
  </article>
  <style is:global>
    .prose a { text-decoration: underline; text-decoration-color: var(--proof); text-decoration-thickness:2px; }
    .prose p { margin-top:1rem; }
    .prose blockquote { border-left:3px solid var(--proof); padding:8px 16px; background:var(--paper-raised); font-style:italic; color:var(--ink-muted); }
  </style>
</Base>
