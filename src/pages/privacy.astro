---
import Base from "../layouts/Base.astro";
---

<Base title="Privacy" description="Privacy and data use — Igbanam." current="">
  <div class="canvas" style="padding: var(--s-8) 0 var(--s-12); max-width:66ch;">
    <h1 class="font-display" style="font-size:2rem; font-weight:800;">Privacy</h1>
    <div style="margin-top:16px; line-height:1.7; display:flex; flex-direction:column; gap:12px;">
      <p>This site does not use advertising trackers, fingerprinting, or cross-site identity graphs.</p>
      <p>Reactions are stored locally in your browser (<code>localStorage</code>) and are not sent to a server. Comments are powered by Giscus (GitHub Discussions) and are loaded only after you click “Discuss this essay”.</p>
      <p>Search is served from a static index built at deploy time. No search queries are logged by this site.</p>
      <p>If analytics is enabled in the future, it will be aggregate and cookieless, and this page will be updated to describe it.</p>
    </div>
  </div>
</Base>
